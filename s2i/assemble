#!/bin/bash

echo "---> Installing new content ..."
rsync -aq /tmp/src/specify_exports/ ./specify_exports/
if [ -f "/tmp/src/nginx/webportal-nginx.conf" ]; then
     echo "---> Applying custom Nginx config ..."
     cp -f /tmp/src/nginx/webportal-nginx.conf /etc/nginx/sites-available/webportal-nginx.conf
     chmod 664 /etc/nginx/sites-available/webportal-nginx.conf
fi
if [ -d "/tmp/src/PortalApp" ]; then
     echo "---> Applying PortalApp resources ..."
     rsync -aq /tmp/src/PortalApp/ ./PortalApp/
     make build-html
fi
if [ -d "/tmp/src/custom_settings" ]; then
     echo "---> Applying custom_settings ..."
     rsync -aq /tmp/src/custom_settings/ ./custom_settings/
     make build-html
fi

# Fix source directory permissions
fix-permissions ./